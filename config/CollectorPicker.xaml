<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autodoc version 1.0" Height="1000" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#F3F4F6"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif" TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <!-- Palette -->
        <SolidColorBrush x:Key="Accent"        Color="#0F6CBD"/>
        <SolidColorBrush x:Key="AccentHover"   Color="#115EA3"/>
        <SolidColorBrush x:Key="AccentPressed" Color="#0E4775"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#1B1B1F"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#5B5B66"/>
        <SolidColorBrush x:Key="CardBorder"    Color="#E5E7EB"/>

        <!-- Primary button (accent filled) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource AccentHover}"/></Trigger>
                            <Trigger Property="IsPressed"   Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource AccentPressed}"/></Trigger>
                            <Trigger Property="IsEnabled"   Value="False"><Setter TargetName="b" Property="Background" Value="#B9C7D6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary button (outlined) -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#B71C1C"/></Trigger>
                            <Trigger Property="IsPressed"   Value="True"><Setter TargetName="b" Property="Background" Value="#8E1B1B"/></Trigger>
                            <Trigger Property="IsEnabled"   Value="False"><Setter TargetName="b" Property="Background" Value="#D9A5A5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="#D4D6DB" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#F0F2F5"/></Trigger>
                            <Trigger Property="IsPressed"   Value="True"><Setter TargetName="b" Property="Background" Value="#E4E7EC"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern checkbox (rounded box + check glyph) -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="19" Height="19" CornerRadius="5"
                                    Background="White" BorderBrush="#B4B6BD" BorderThickness="1.5"
                                    VerticalAlignment="Top" Margin="0,1,10,0">
                                <TextBlock x:Name="check" Text="&#x2713;" Foreground="White" FontSize="12"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box"   Property="Background"  Value="{StaticResource Accent}"/>
                                <Setter TargetName="box"   Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="check" Property="Visibility"  Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat tab control -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Underlined tab headers -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="b" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="0,0,0,2.5" Padding="18,10" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card container -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.10"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header band -->
        <Border Grid.Row="0" Padding="20,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F6CBD" Offset="0"/>
                    <GradientStop Color="#1F4E8C" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="Autodoc" Foreground="White" FontSize="22" FontWeight="Bold"/>
        </Border>

        <!-- Body: left nav rail + content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation rail (products, grouped by suite) -->
            <Border Grid.Column="0" Background="#F7F8FA" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,14,0,0">
                    <TextBlock Text="M365" Foreground="#8A909B" FontSize="11" FontWeight="SemiBold" Margin="16,0,0,8"/>
                    <!-- Selected product. Add more items here later (Intune, Exchange, ...) -->
                    <Border Background="#E8F1FA" BorderBrush="{StaticResource Accent}" BorderThickness="3,0,0,0"
                            CornerRadius="0,6,6,0" Padding="13,9" Margin="0,0,10,2">
                        <TextBlock Text="Entra" Foreground="{StaticResource Accent}" FontSize="14" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Content: action tabs for the selected product -->
            <TabControl x:Name="ActionTabs" Grid.Column="1" Margin="16,10,16,4">

                <!-- Download data -->
                <TabItem Header="Download Data">
                    <DockPanel Margin="4,14,4,4">
                        <TextBlock DockPanel.Dock="Top" Text="Select the sections to run"
                                   FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="2,0,0,2"/>

                        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10">
                            <Button x:Name="BtnDisconnect" DockPanel.Dock="Right" Content="Disconnect Graph"
                                    Width="150" Height="30" Style="{StaticResource DangerButton}"
                                    ToolTip="Sign out of Microsoft Graph so the next collection lets you pick another tenant."/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnAll"  Content="Select all"   Width="100" Height="30" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"/>
                                <Button x:Name="BtnNone" Content="Deselect all" Width="100" Height="30" Style="{StaticResource SecondaryButton}"/>
                            </StackPanel>
                        </DockPanel>

                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="File formats" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="ExportCsv"   Content="CSV"   IsChecked="True" Margin="0,0,22,0"/>
                                    <CheckBox x:Name="ExportJson"  Content="JSON"  IsChecked="True" Margin="0,0,22,0"/>
                                    <CheckBox x:Name="ExportExcel" Content="Excel" IsChecked="True"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                                <StackPanel x:Name="CollectorList"/>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </TabItem>

                <!-- Generate documents -->
                <TabItem Header="Generate Documents">
                    <DockPanel Margin="4,14,4,4">
                        <TextBlock DockPanel.Dock="Top" Text="Generate documents"
                                   FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="2,0,0,6"/>
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,12">
                            <Run Text="Pick the formats to build from the selected export, then click Run."/>
                            <Run Text=" (Several can be built at once. These are built from the folder rawDataJson.)" FontSize="11" Foreground="#666666"/>
                        </TextBlock>
                        <Border Style="{StaticResource Card}" Padding="16" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Formats" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="DocExcel" Margin="0,0,0,8"><TextBlock><Run Text="Excel report"/><Run Text="  (KPI workbook)" FontSize="11" Foreground="#666666"/></TextBlock></CheckBox>
                                <CheckBox x:Name="DocSvg"   Content="SVG maps" Margin="0,0,0,8"/>
                                <CheckBox x:Name="DocHtml"  Margin="0,0,0,8"><TextBlock TextWrapping="Wrap"><Run Text="HTML report"/><Run Text="  (Builds the SVG maps automatically if they aren't made yet)" FontSize="11" Foreground="#666666"/></TextBlock></CheckBox>
                                <CheckBox x:Name="DocWord"  Margin="0,0,0,8"><TextBlock><Run Text="Word report"/></TextBlock></CheckBox>
                                <StackPanel Orientation="Horizontal" Margin="26,0,0,2">
                                    <TextBlock Text="Language:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Width="105" Margin="0,0,12,0"/>
                                    <ComboBox x:Name="WordLanguage" Width="170" Height="26" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="26,6,0,2">
                                    <TextBlock Text="Company logo:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Width="105" Margin="0,0,12,0"/>
                                    <Grid Width="240">
                                        <TextBox x:Name="WordCompanyLogo" Height="26" VerticalContentAlignment="Center"/>
                                        <TextBlock Text="optional" Foreground="#999999" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=WordCompanyLogo}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button x:Name="BtnCompanyLogo" Content="Browse…" Height="26" Margin="8,0,0,0" Padding="10,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="26,2,0,2">
                                    <TextBlock Text="Client logo:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Width="105" Margin="0,0,12,0"/>
                                    <Grid Width="240">
                                        <TextBox x:Name="WordClientLogo" Height="26" VerticalContentAlignment="Center"/>
                                        <TextBlock Text="optional" Foreground="#999999" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=WordClientLogo}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button x:Name="BtnClientLogo" Content="Browse…" Height="26" Margin="8,0,0,0" Padding="10,0"/>
                                </StackPanel>
                                <TextBlock Foreground="#666666" FontSize="11" Margin="26,4,0,4" TextWrapping="Wrap"
                                           Text="Copies the selected file to cache\wordTemplates\template\img (companylogo / clientlogo). Word reads the logos from there."/>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </TabItem>

            </TabControl>
        </Grid>

        <!-- Report source folder (used by the report tabs only) -->
        <Border x:Name="ReportSourcePanel" Grid.Row="2" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Report source" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,10,0"/>
                <Button x:Name="BtnBrowse" DockPanel.Dock="Right" Content="Browse..." Width="90" Height="28"
                        Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="BtnReloadSource" DockPanel.Dock="Right" Content="Reload" Width="70" Height="28"
                        Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" ToolTip="Rescan the exports folder for new exports"/>
                <ComboBox x:Name="SourceFolders" Height="28" VerticalContentAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Footer buttons -->
        <Border Grid.Row="3" Background="#ECEEF1" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" FontSize="12" Text="Ready"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnRun"    Content="Run"    Width="130" Height="34" Margin="0,0,8,0" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="BtnCancel" Content="Close" Width="96"  Height="34" IsCancel="True"  Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
